# STUDIO AI — variables d'environnement facultatives.
# Les clés peuvent aussi être saisies dans Paramètres > Clés API (elles sont alors chiffrées dans studio-data/).
# Copier ce fichier en .env.local puis remplir uniquement ce dont vous avez besoin.

# Dossier des données (projets, rendus, clés chiffrées). Par défaut : ./studio-data
# STUDIO_DATA_DIR=/Users/moi/Movies/StudioAI

# Moteurs payants (facultatifs)
# FAL_KEY=
# REPLICATE_API_TOKEN=
# STABILITY_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ELEVENLABS_API_KEY=

# Moteurs locaux (facultatifs)
# OLLAMA_URL=http://127.0.0.1:11434
# SD_WEBUI_URL=http://127.0.0.1:7860
